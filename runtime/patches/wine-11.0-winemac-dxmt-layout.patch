+macdrv_view macdrv_get_window_content_view(macdrv_window w)
+{
+    WineWindow* window = (WineWindow*)w;
+    __block macdrv_view view;
+
+    OnMainThread(^{
+        view = (macdrv_view)[window contentView];
+    });
+
+    return view;
+}
