+/* Stockade: keep the view DXMT uses current. Wine 11 only sets client_view
+ * for windows with a GL/Vulkan client surface, so fall back to the content view. */
+static void update_dxmt_view(struct macdrv_win_data *data)
+{
+    if (data->client_view) data->dxmt_view = data->client_view;
+    else data->dxmt_view = data->cocoa_window ? macdrv_get_window_content_view(data->cocoa_window) : NULL;
+}
